# Supabase Configuration
# Obtain these from your Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Set to true if you want to use the rich offline demo mode with seeded data
VITE_USE_MOCK_DATA=true

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# ⚠️  VAPID_PUBLIC_KEY is SAFE to put here (frontend-visible)
# ⚠️  VAPID_PRIVATE_KEY must ONLY be set in Supabase Edge Function secrets:
#     supabase secrets set VAPID_PRIVATE_KEY=your_private_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
