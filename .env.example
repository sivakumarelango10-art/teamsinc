# ─────────────────────────────────────────────────────────────────────────────
# TeamSync Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# 2. Offline Demo / Mock Data Mode (set to false for live Supabase)
VITE_USE_MOCK_DATA=false

# 3. Web Push Notifications (VAPID)
# Generated with: npx web-push generate-vapid-keys
# ⚠️ Public key is safe in frontend. Set private key in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# 4. Google Gemini AI Multi-Role API Keys
# Obtain from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY_FOUNDER=your-gemini-api-key-for-founder
VITE_GEMINI_API_KEY_ADMIN=your-gemini-api-key-for-admin
VITE_GEMINI_API_KEY_ADVISOR=your-gemini-api-key-for-advisor

# 4.1 Secure server-side Supabase Auth verification (used by live attendance APIs)
# These can share the same project URL and anon key as the frontend values above.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# 5. Server Database URL (Prisma / Migrations only - Never expose in client)
DATABASE_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# 6. Server-to-Server API Security (Never expose in client)
TEAMSYNC_API_KEY=your-secure-server-api-key-here
TEAMSYNC_API_URL=https://teamsync-fawn.vercel.app

